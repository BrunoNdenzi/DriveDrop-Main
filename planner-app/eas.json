{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_PLANNER_URL": "https://drivedrop.us.com/route-planner" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_PLANNER_URL": "https://drivedrop.us.com/route-planner" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_PLANNER_URL": "https://drivedrop.us.com/route-planner" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    }
  }
}
