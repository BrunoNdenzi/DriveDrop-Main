{
  "expo": {
    "name": "DriveDrop Route Planner",
    "slug": "drivedrop-route-planner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "drivedroproute",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101d1e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drivedrop.routeplanner",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Benji uses speech recognition to understand what you say.",
        "NSMicrophoneUsageDescription": "Benji uses the microphone so you can talk to him while you drive."
      }
    },
    "android": {
      "package": "com.drivedrop.routeplanner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123638"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "DriveDrop Route Planner shares your position with your dispatcher and your customers' ETA links while a trip is running, even when the app is in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Benji uses the microphone so you can talk to him while you drive.",
          "speechRecognitionPermission": "Benji uses speech recognition to understand what you say.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "98416827-2a43-4ecb-a05b-8e7966d5fddf"
      }
    },
    "owner": "drivedrop"
  }
}
